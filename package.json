{
  "name": "@local/dsh-novel-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "English novel reader with word selection translation, vocabulary notebook, quizzes, reading history and WebDAV sync for DeepSeek Harness.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "client",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "fast-xml-parser": "^4.5.3",
    "jszip": "^3.10.1",
    "sanitize-html": "^2.17.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
